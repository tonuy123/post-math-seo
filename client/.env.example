# =====================================================
# Client Environment Variables
# Copy this file to `.env` and fill in real values
# =====================================================

# Base URL của API backend.
# - Development: giữ trống → Vite proxy /api → http://localhost:5000
# - Production : ghi URL API thật, ví dụ: https://api.example.com/api/v1
VITE_API_BASE_URL=

# Firebase Web SDK config (nếu dùng Firebase Auth phía client)
# Lấy từ Firebase Console > Project Settings > General
#VITE_FIREBASE_API_KEY=
#VITE_FIREBASE_AUTH_DOMAIN=
#VITE_FIREBASE_PROJECT_ID=
#VITE_FIREBASE_STORAGE_BUCKET=
#VITE_FIREBASE_MESSAGING_SENDER_ID=
#VITE_FIREBASE_APP_ID=
