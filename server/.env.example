# =====================================================
# Server Environment Variables
# Copy this file to `.env` and fill in real values
# =====================================================

# HTTP
PORT=5000
NODE_ENV=development
# Danh sách origin được phép gọi API (phân cách bằng dấu phẩy).
# Production: ghi domain CMS thật vào đây, ví dụ: https://cms.example.com,https://admin.example.com
CLIENT_ORIGIN=http://localhost:5173

# Firebase Admin SDK (DO NOT commit the JSON file)
# Path to the service account JSON file downloaded from Firebase Console
FIREBASE_SERVICE_ACCOUNT_PATH=./config/serviceAccountKey.json

# Firestore
FIRESTORE_POSTS_COLLECTION=posts
FIRESTORE_USERS_COLLECTION=users

# App Constants
MAX_FEATURED_IMAGE_BYTES=524288
TRASH_RETENTION_HOURS=24
DEFAULT_BASE_DOMAIN=https://tuyensinh.quocteviet.edu.vn/

# ── Static site generation (SEO public) ──────────────────────────────
# Domain public nơi blog được sinh ra (không có trailing slash)
PUBLIC_BASE_URL=https://tuyensinh.quocteviet.edu.vn
PUBLIC_SITE_NAME=Tuyen Sinh Thac Si - Tap doan Quoc Te Viet

# ── FTP deploy (cPanel) ──────────────────────────────────────────────
FTP_HOST=ftp.example.com
FTP_USER=username
FTP_PASS=password
FTP_PORT=21
# Thư mục gốc public trên hosting, ví dụ: /public_html (để trống nếu là /)
FTP_ROOT=/public_html

# Seed Admin (created on first boot if no admin exists)
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin123

# Server-issued JWT (used by /auth/login as a fallback when no Firebase Web SDK is wired yet)
JWT_SECRET=please-change-this-to-a-long-random-string
JWT_EXPIRES_IN=12h
