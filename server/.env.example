# =====================================================
# Server Environment Variables
# Copy this file to `.env` and fill in real values
# =====================================================

# HTTP
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Firebase Admin SDK (DO NOT commit the JSON file)
# Path to the service account JSON file downloaded from Firebase Console
FIREBASE_SERVICE_ACCOUNT_PATH=./config/serviceAccountKey.json

# Firestore
FIRESTORE_POSTS_COLLECTION=posts
FIRESTORE_USERS_COLLECTION=users

# App Constants
MAX_FEATURED_IMAGE_BYTES=524288
TRASH_RETENTION_HOURS=24
DEFAULT_BASE_DOMAIN=https://tuyensinh.quocteviet.edu.vn/

# Seed Admin (created on first boot if no admin exists)
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin123

# Server-issued JWT (used by /auth/login as a fallback when no Firebase Web SDK is wired yet)
JWT_SECRET=please-change-this-to-a-long-random-string
JWT_EXPIRES_IN=12h
